# ============================================================================
# QCC Church Management System - Environment Variables
# ============================================================================
#
# REQUIRED FOR ALL ENVIRONMENTS (Development, Testing, Production)
# ============================================================================

# Supabase Postgres connection string
# Use the Session pooler connection string (recommended for Vercel/serverless)
# Location: Supabase dashboard → Project Settings → Database → Connection pooling
# Format: postgresql://postgres.[project-id]:[password]@[region].pooler.supabase.com:5432/postgres
# Example: postgresql://postgres.abcde:mypassword@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# ============================================================================
# REQUIRED FOR INITIAL SETUP ONLY (One-time seeding)
# ============================================================================
# After running 'npm run db:seed', these can be removed or left unchanged.
# They are only used by the seed script to create the initial Chief Admin.

# Initial Chief Admin username (alphanumeric, will be lowercased)
# Default: chiefadmin
SEED_ADMIN_USERNAME=chiefadmin

# Initial Chief Admin password (minimum 8 characters recommended)
# Default: change-me-now
# IMPORTANT: Change this immediately after first login
SEED_ADMIN_PASSWORD=change-me-now

# ============================================================================
# PHOTO STORAGE (required for fellowship photo uploads)
# ============================================================================
# Supabase Storage is used for now. Create a bucket (default name below) in
# the Supabase dashboard → Storage, and mark it public so getPublicUrl()
# links resolve. Migrating to Cloudflare R2 or another provider later only
# requires rewriting packages/core/src/storage.ts.

# Project URL: Supabase dashboard → Project Settings → API → Project URL
SUPABASE_URL=https://xxxx.supabase.co

# Service role key (NOT the anon key — this bypasses RLS for server-side uploads)
# Location: Supabase dashboard → Project Settings → API → service_role secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Storage bucket name (create this bucket in Supabase dashboard → Storage)
# Default: qcc-photos
SUPABASE_STORAGE_BUCKET=qcc-photos

# ============================================================================
# OPTIONAL / NOT CURRENTLY USED
# ============================================================================
# NODE_ENV=development
